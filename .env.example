# Copy this file to .env and adjust as needed:  cp .env.example .env
# .env is gitignored (holds real values); .env.example is committed (the template).

# --- Postgres container (read by the postgres:16 image on first boot) ---
POSTGRES_USER=linkpulse
POSTGRES_PASSWORD=linkpulse
POSTGRES_DB=linkpulse

# --- Application database URL ------------------------------------------
# Used by the backend (LP-2) and Alembic. Uses the asyncpg driver for
# SQLAlchemy 2 async. Host is localhost:5432 because during dev the backend
# runs on your machine and reaches Postgres through the published port.
# (In the fully containerised setup, LP-3b, the backend service overrides
#  the host to `db` — the compose service name.)
DATABASE_URL=postgresql+asyncpg://linkpulse:linkpulse@localhost:5432/linkpulse
